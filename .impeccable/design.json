  "narrative": {
    "northStar": "A birthplace becomes a story worth keeping",
    "overview": "A birthplace becomes a story worth keeping. The locally implemented A/B/C world pairs scenic original artwork with readable life stories, real start controls and actual collectible specimens. Clear blue (default), travel journal, modern editorial and cinema at dusk are four distinct compositions within one product. Batch B extends this world into real birth, playback, decision, ending, studio and order surfaces; Batch C carries it through reading pages, comparison and odds tools, country discovery, callbacks and 404.\n\nThis is the current local normal production-build candidate, with all four themes and A/B/C surfaces implemented. THEME_PREVIEW now adds only noindex sample studies/prototypes; the shared shell and reading/tool body migration run in normal builds. Exact-Git deployment and production-domain acceptance remain pending, including C04 new-UI/old-paid-order export verification. Historical production v1.16.9 and earlier opt-in/nonactive preview evidence do not establish this candidate as deployed. Batch B local UI and actual Stripe TEST delivery retain their scoped acceptance; live charging remains closed. Direction is code-led from the approved reference world; no generated-comp approval or concept seed is claimed. The existing keepsake system remains independently documented below.",
    "keyCharacteristics": [
      "Four scenic worlds with stable product meaning.",
      "Locally hosted display lettering and readable local UI stacks.",
      "Real sample facts, visible controls and expanded core content.",
      "Symbolic gouache life stages, readable operating surfaces and work-first studio previews.",
      "Quiet expanded reading rooms and native data tools across all four themes."
    ],
    "rules": [
      {
        "name": "The Independent Appearance Rule",
        "body": "Website appearance never selects an export template or recolors PNG/PDF artifacts.",
        "section": "colors"
      },
      {
        "name": "The Stable Meaning Rule",
        "body": "Theme changes alter presentation; start, continue, saved lives, simulation streams and order meaning stay stable.",
        "section": "components"
      },
      {
        "name": "The Recorded Life Rule",
        "body": "Symbolic scenery and personal writing never supply missing facts for a completed record.",
        "section": "components"
      }
    ],
    "dos": [
      "Do keep story facts tied to actual sample or completed-life events.",
      "Do retain readable local-script controls, visible focus and expanded core content.",
      "Do adapt composition by theme while preserving mobile task order.",
      "Do keep pending decisions paused when set aside, and give the selected studio work first-viewport authority."
    ],
    "donts": [
      "Don't describe locally implemented A/B/C or nonactive version-preview acceptance as exact-Git deployment, production-domain acceptance or live payment approval.",
      "Don't copy reference screenshots, invented people, popularity claims or competitor media into the product.",
      "Don't couple website themes to the six keepsake export templates.",
      "Don't treat order UI mocks, redirect success or a client-side paid label as export authorization."
    ]
  }
}
